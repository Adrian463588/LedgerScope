{
  "name": "ledgerscope-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/vue-tsc/bin/vue-tsc.js && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"cypress/**/*.{ts,vue}\" \"*.{ts,json}\"",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest",
    "test:e2e": "cypress run"
  },
  "dependencies": {
    "@inertiajs/vue3": "^2.3.27",
    "@vee-validate/zod": "^4.15.1",
    "axios": "^1.19.0",
    "chart.js": "^4.5.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.6.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "cypress": "^15.16.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "laravel-vite-plugin": "^3.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3",
    "ziggy-js": "^2.6.2"
  }
}
