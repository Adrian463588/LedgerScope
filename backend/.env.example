APP_NAME=LedgerScope
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional bootstrap account. Never commit real values.
LEDGERSCOPE_SUPERADMIN_NAME=Super Admin
LEDGERSCOPE_SUPERADMIN_EMAIL=
LEDGERSCOPE_SUPERADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ledgerscope
DB_USERNAME=ledgerscope_user
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
PRIVATE_FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=ledgerscope_minio
AWS_SECRET_ACCESS_KEY=minio_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ledgerscope-private
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

LEDGERSCOPE_RED_FLAG_LARGE_ENTRY_THRESHOLD=100000
LEDGERSCOPE_RED_FLAG_NEAR_THRESHOLD_PERCENT=0.02

# External providers remain fail-closed until a reviewed adapter and credentials exist.
LEDGERSCOPE_ERP_ENABLED=false
LEDGERSCOPE_PAYROLL_ENABLED=false
LEDGERSCOPE_INVENTORY_ENABLED=false
LEDGERSCOPE_TAX_ENABLED=false
LEDGERSCOPE_BANKING_ENABLED=false
LEDGERSCOPE_SSO_ENABLED=false
LEDGERSCOPE_OCR_ENABLED=false
LEDGERSCOPE_AI_ENABLED=false
LEDGERSCOPE_MOBILE_SYNC_ENABLED=false
LEDGERSCOPE_ANOMALY_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
