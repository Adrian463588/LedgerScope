# ==============================================================================
# LedgerScope Production Environment Variables Configuration (Coolify)
# ==============================================================================
# Copy these values into the "Environment Variables" section of your Coolify application stack.
# DO NOT commit actual secrets to version control.

# --- Domain & URL Configuration ---
# Set these to your production domains (Coolify will manage HTTPS certificates)
APP_FRONTEND_URL=https://ledgerscope.yourdomain.com
APP_BACKEND_URL=https://api.ledgerscope.yourdomain.com

# --- Core Laravel Settings ---
# Generate a secure key using: php artisan key:generate --show
APP_KEY=base64:YOUR_GENERATED_SECURE_KEY_HERE
APP_ENV=production
APP_DEBUG=false

# --- Database Kredensial ---
# Used internally by the postgres service container
DB_PASSWORD=YOUR_GENERATED_SECURE_DB_PASSWORD_HERE

# --- Redis Configuration (Internal) ---
# Managed automatically by Docker network, no secret keys needed internally
REDIS_PORT=6379

# --- Object Storage (DevSecOps Options) ---

# OPTION A: Google Cloud Storage (Recommended GCP Native)
# 1. Create a GCS bucket, e.g. 'ledgerscope-evidence-vault'.
# 2. Go to GCS Settings > Interoperability > Create HMAC key.
# 3. Use the credentials below:
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=GOOG1EXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=YOUR_GCS_HMAC_SECRET_KEY_HERE
AWS_DEFAULT_REGION=asia-southeast1
AWS_BUCKET=ledgerscope-evidence-vault
AWS_ENDPOINT=https://storage.googleapis.com

# OPTION B: Self-Hosted MinIO (Fallback inside Coolify)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=ledgerscope_minio
# AWS_SECRET_ACCESS_KEY=YOUR_MINIO_ROOT_PASSWORD_HERE
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=ledgerscope-evidence
# AWS_ENDPOINT=http://ledgerscope-minio:9000
# MINIO_ROOT_PASSWORD=YOUR_MINIO_ROOT_PASSWORD_HERE
# MINIO_API_URL=https://s3.ledgerscope.yourdomain.com
# MINIO_CONSOLE_URL=https://s3-console.ledgerscope.yourdomain.com

# --- Mail & SMTP Settings ---
# In production, use a reliable provider like SendGrid, Postmark, or Mailgun
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SMTP_API_KEY_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ledgerscope.yourdomain.com
MAIL_FROM_NAME="LedgerScope Platform"
